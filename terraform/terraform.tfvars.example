# Copy to terraform.tfvars and fill in before `terraform apply`.
# terraform.tfvars is gitignored — never commit real secrets.

aws_region      = "us-east-1"
project_name    = "asd"
environment     = "prod"

# Your public SSH key (content of ~/.ssh/id_ed25519.pub), used to create the
# EC2 key pair. The CI pipeline logs in with the matching private key.
ssh_public_key  = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@example.com"

# Restrict SSH to your own IP (get it from https://checkip.amazonaws.com).
# ssh_cidr      = "203.0.113.10/32"

# Optional overrides. Leave the *_secret values empty to auto-generate them
# (stored in Terraform state as sensitive values).
# db_password   = ""
# jwt_secret    = ""

# Optional LLM. Leave llm_api_key empty for the deterministic fallback.
# llm_provider  = "openai"
# llm_api_key   = ""
# llm_model     = "gpt-4o-mini"
