# Copy to .env for local dev. Docker Compose reads this file automatically.
DATABASE_URL="postgresql://asd:asd@localhost:5432/asd?schema=public"
JWT_SECRET="dev-secret-change-me"
PORT=4000
CORS_ORIGIN="*"

# LLM (optional). Leave LLM_API_KEY empty to use the deterministic fallback.
# LLM_PROVIDER: openai | anthropic | deepseek | openrouter | openai-compatible
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Set to "false" to skip seeding demo data on container start.
SEED_ON_START=true
